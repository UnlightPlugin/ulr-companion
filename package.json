{
  "name": "ulr-companion-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "UNLIGHT:Revive 自訂 COST 規則與對戰追蹤 — ULR Companion 執行端",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p apps/link-worker --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tray:build": "node scripts/build-tray.mjs",
    "tray": "npm run tray:build && node scripts/run-tray.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vectors:generate": "tsx packages/rule-schema/scripts/generate-vectors.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:worker && npm run test",
    "dist": "tsx scripts/pack-tray.mjs",
    "release:keygen": "node scripts/keygen-release.mjs",
    "release:sign": "tsx scripts/sign-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
