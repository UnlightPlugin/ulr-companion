{
  "manifest_version": 3,
  "name": "UNLIGHT:Revive Steam 登入",
  "version": "1.0.0",
  "description": "不開 Steam 用戶端，直接用 Steam 帳號在瀏覽器玩 UNLIGHT:Revive。",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": [
    "https://api.steampowered.com/*",
    "wss://*.steamserver.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "steam_origin", "enabled": true, "path": "rules.json" }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.playunlight.online/?*",
        "https://www.playunlight.online/stove?*"
      ],
      "js": ["game_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.playunlight.online/?*",
        "https://www.playunlight.online/stove?*"
      ],
      "js": ["game.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "開始玩 UNLIGHT:Revive",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
