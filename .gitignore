node_modules/
dist/
build/
release/
out/
# wrangler 的本機狀態與打包暫存（apps/link-worker）
.wrangler/
*.tsbuildinfo
coverage/
.vitest/

# ---------------------------------------------------------------------------
# 機密：絕對不能進版控
# ---------------------------------------------------------------------------
# 遊戲的 WebSocket 封包裡帶 Steam session token（36 碼）與含 steamid/token 的
# 遊戲網址。規格書 §12 明訂不得記錄或上傳這些東西。
# 要提交 fixture 給測試用，一律先跑 `npm run fixture:scrub` 去識別化。
*.log
packets.log
/fixtures/raw/
**/battle/
**/deck/
**/bonus/

.env
.env.*
!.env.example
*.pem
*.pfx
*.p12

# 本機規則包（可能是還沒發布的私人約測規則）
*.ulrcost.json
!packages/rule-schema/test-vectors/**/*.ulrcost.json
# 例外：/rules/ 是從客戶端匯出的原版 COST 表，是要給大家 fork 的參考資料，
# 不是私人約測規則。用 `companion official-rule` 重新產生。
!/rules/*.ulrcost.json

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# unpack 的產物。⚠ 它跟 .ulrcost.json 是同一份規則的兩種包裝，兩個檔一起躺在
# rules/ 裡會被當成「有兩份 shinon 規則」。要看內容就當場 unpack，不要留檔。
rules/*.rule.json

# 給人下載用的壓縮檔。規則的**唯一來源**是同名的 .ulrcost.json —— 壓縮檔進了
# 版控就會有第二份內容可以漂移，而且 diff 看不出來。要發給人就當場壓。
rules/*.rar
rules/*.zip
